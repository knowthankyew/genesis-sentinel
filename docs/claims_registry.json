      "description": "Automated Go test or governance check verification marker",
      "evidence": [
        "internal/security/security_test.go:TestIsLoopbackEndpoint",
        "internal/model/types_test.go:TestValidateBaseModel",
        "internal/config/config_test.go:TestConfigRejectsBitNetAndNonLoopback",
        "internal/cli/cli_test.go:TestExecuteDataSubcommands"
      ]
    },
